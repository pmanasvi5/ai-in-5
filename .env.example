# Copy this file to .env for LOCAL testing only (it's gitignored).
# In GitHub Actions, set GEMINI_API_KEY as a repository secret instead —
# see README.md "API Setup".
#
# Optional. If unset, the pipeline automatically uses its built-in
# non-generative, source-grounded summarizer instead — no AI API required.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash (a free-tier model as of writing).
GEMINI_MODEL=gemini-2.0-flash
